+static atomic_t l2c310_coherent_clean_calls = ATOMIC_INIT(0);
+
+static void l2c310_coherent_clean_range_debug(unsigned long start,
+					      unsigned long end)
+{
+	atomic_inc(&l2c310_coherent_clean_calls);
+	l2c210_clean_range(start, end);
+}
+
+static int __init l2c310_coherent_clean_debug_init(void)
+{
+	debugfs_create_atomic_t("l2c310_coherent_clean_calls", 0444, NULL,
