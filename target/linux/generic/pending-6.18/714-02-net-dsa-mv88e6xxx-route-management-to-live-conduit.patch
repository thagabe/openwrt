Subject: [PATCH] net: dsa: mv88e6xxx: route shared management traffic to a live conduit

With multiple CPU ports, setup writes the global CPU destination once
for each CPU port. The last one is not necessarily opened by a user port,
which can strand management traffic on an inactive conduit.

Use the existing conduit state notification and chip operations to select
an operational local CPU port for shared management and PTP destinations.
The DSA tagger resolves the source port within the tree, regardless of the
receiving conduit. Keep user-configured mirror destinations unchanged.

Limit this to switches with multiple local CPU ports and no DSA links;
selection of a management path through a cascaded fabric is separate work.

---
--- a/drivers/net/dsa/mv88e6xxx/chip.c
+++ b/drivers/net/dsa/mv88e6xxx/chip.c
@@ -3367,6 +3367,45 @@
 	return 0;
 }
 
+/* Management destinations are shared on chips without per-port CPU
+ * selection. DSA tags identify the source switch and port independently
+ * of the receiving conduit, so any operational local CPU link can carry
+ * these frames. Do not repurpose the independently configured mirrors.
+ */
+static void
+mv88e6xxx_conduit_state_change(struct dsa_switch *ds,
+			       const struct net_device *conduit,
+			       bool operational)
+{
+	struct mv88e6xxx_chip *chip = ds->priv;
+	const struct mv88e6xxx_ops *ops = chip->info->ops;
+	struct dsa_port *cpu_dp, *dp;
+	int err = 0;
+
+	if (hweight32(dsa_cpu_ports(ds)) < 2)
+		return;
+
+	dsa_switch_for_each_port(dp, ds)
+		if (dsa_port_is_dsa(dp))
+			return;
+
+	dsa_switch_for_each_cpu_port(cpu_dp, ds) {
+		if (!dsa_port_conduit_is_operational(cpu_dp))
+			continue;
+
+		mv88e6xxx_reg_lock(chip);
+		if (ops->set_cpu_port)
+			err = ops->set_cpu_port(chip, cpu_dp->index);
+		if (!err && ops->ptp_ops && ops->ptp_ops->set_ptp_cpu_port)
+			err = ops->ptp_ops->set_ptp_cpu_port(chip, cpu_dp->index);
+		mv88e6xxx_reg_unlock(chip);
+		if (err)
+			dev_err(ds->dev, "failed to update CPU destination: %pe\n",
+				ERR_PTR(err));
+		break;
+	}
+}
+
 static int mv88e6xxx_setup_port(struct mv88e6xxx_chip *chip, int port)
 {
 	struct fwnode_handle *ports_fwnode;
@@ -7142,6 +7181,7 @@
 static const struct dsa_switch_ops mv88e6xxx_switch_ops = {
 	.get_tag_protocol	= mv88e6xxx_get_tag_protocol,
 	.change_tag_protocol	= mv88e6xxx_change_tag_protocol,
+	.conduit_state_change	= mv88e6xxx_conduit_state_change,
 	.setup			= mv88e6xxx_setup,
 	.teardown		= mv88e6xxx_teardown,
 	.port_setup		= mv88e6xxx_port_setup,
